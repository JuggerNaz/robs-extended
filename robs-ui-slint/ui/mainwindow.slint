//! ROBS shell: top menu bar + status chips, QID rail (left), a scene selector
//! bar above the letterboxed live preview canvas, centered Quick Actions bar,
//! and the right column split into two stacked tab rows: Sources / Overlays /
//! Audio above, Stats / Log below (Chat is hidden for now; the former Scenes
//! tab became the scene bar + its gear dialog above the canvas).
//!
//! All colors/spacing come from `Theme`; all data flows through the frozen
//! `Api` global. Item geometry and the canvas box are computed in the Rust
//! glue each tick.

import { Theme } from "theme.slint";
import { Api } from "api.slint";
// Bundled UI typeface (SIL OFL — see `assets/fonts/OFL.txt`): importing the
// TTFs embeds and registers them with Slint at compile time, making the
// "Nunito" family globally available (picked up by the window's
// `default-font-family` below) so the shell renders the same on machines
// without the font installed.
import "../assets/fonts/Nunito-Regular.ttf";
import "../assets/fonts/Nunito-SemiBold.ttf";
import "../assets/fonts/Nunito-Bold.ttf";
// Re-export so `slint::include_modules!()` exposes the Api global to the
// Rust glue.
export { Api }
import { EventLogTab } from "event_log_tab.slint";
import { SourcesTab } from "sources_tab.slint";
import { SourcePropertiesDialog } from "source_properties.slint";
// Re-export so `slint::include_modules!()` exposes the Phase 2 global to the
// Rust glue as well.
import { SourcesApi } from "sources_api.slint";
export { SourcesApi }
import { PanelsApi } from "panels_api.slint";
export { PanelsApi }
import { MenuBar } from "menubar.slint";
import { AudioTab } from "audio_tab.slint";
import { ChatTab } from "chat_tab.slint";
import { StatsTab } from "stats_tab.slint";
import { SettingsWindow } from "settings.slint";
import { TelemetryApi } from "telemetry_api.slint";
// Re-export so the Rust glue can drive the telemetry bar + dialog.
export { TelemetryApi }
import { TelemetryDialog } from "telemetry_dialog.slint";
import { QidApi } from "qid_api.slint";
// Re-export so the Rust glue can drive the QID rail.
export { QidApi }
import { QidRail } from "qid_rail.slint";
import { OverlaysTab } from "overlays_tab.slint";
import { SceneApi } from "scene_api.slint";
// Re-export so the Rust glue can drive the scene rename/remove callbacks.
export { SceneApi }
import { SceneDialog } from "scene_dialog.slint";
import { TabWidget, Palette, LineEdit } from "std-widgets.slint";
import { AnnotationToolbar, ResizeHandle, OverlayLabel } from "annotations.slint";
import { CanvasApi } from "canvas_api.slint";
// Re-export so the Rust glue can drive the canvas editing layer.
export { CanvasApi }

// One Quick Actions bar button: a 64x50 tile with a single-color vector
// glyph above a label. Every button shares ONE neutral theme (card surface,
// 1px border, 8px radius) — states are shown by the glyph/label, not
// per-button colors. Glyphs are drawn as `Path` shapes, not font glyphs: the
// default UI font lacks the old codepoints (tofu boxes) and emoji fonts
// render multicolored, which the design forbids. With `enabled == false`
// the button is dimmed and inert but keeps its footprint.
component QuickButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> enabled;
    callback clicked();

    // One tint for every glyph variant; dims with the button.
    property <color> icon-color: root.enabled ? Theme.text : Theme.text-dim;

    width: 64px;
    height: 50px;
    border-radius: Theme.radius;
    background: !root.enabled ? Theme.window
        : (touch.has-hover ? Theme.border : Theme.card);
    border-width: 1px;
    border-color: Theme.border;

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: self.has-hover && root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }

    // Glyph slot: transparent area holding the one vector variant the `icon`
    // string names. Every variant shares `icon-color`, so all icons stay
    // single-color regardless of font availability.
    Rectangle {
        x: 4px;
        y: 7px;
        width: parent.width - 8px;
        height: 20px;

        if root.icon == "play": Path {
            width: 16px;
            height: 16px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            viewbox-width: 16;
            viewbox-height: 16;
            commands: "M 2 1 L 15 8 L 2 15 Z";
            fill: root.icon-color;
        }
        if root.icon == "pause": Path {
            width: 16px;
            height: 16px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            viewbox-width: 16;
            viewbox-height: 16;
            commands: "M 3 2 L 6 2 L 6 14 L 3 14 Z M 10 2 L 13 2 L 13 14 L 10 14 Z";
            fill: root.icon-color;
        }
        if root.icon == "stop": Path {
            width: 16px;
            height: 16px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            viewbox-width: 16;
            viewbox-height: 16;
            commands: "M 2.5 2.5 L 13.5 2.5 L 13.5 13.5 L 2.5 13.5 Z";
            fill: root.icon-color;
        }
        // Signal bars (stream activity).
        if root.icon == "stream": Path {
            width: 16px;
            height: 16px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            viewbox-width: 16;
            viewbox-height: 16;
            commands: "M 1 10 L 4 10 L 4 15 L 1 15 Z M 6 6.5 L 9 6.5 L 9 15 L 6 15 Z M 11 2 L 14 2 L 14 15 L 11 15 Z";
            fill: root.icon-color;
        }
        // Camera body (stroked outline) + lens (filled dot).
        if root.icon == "camera": Rectangle {
            width: 16px;
            height: 16px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            Path {
                width: 16px;
                height: 16px;
                viewbox-width: 16;
                viewbox-height: 16;
                commands: "M 1.5 4.5 L 4.5 4.5 L 5.5 2.5 L 9 2.5 L 9.5 4.5 L 14.5 4.5 L 14.5 13.5 L 1.5 13.5 Z";
                stroke: root.icon-color;
                stroke-width: 1.25px;
                fill: transparent;
            }
            Rectangle {
                x: 5.75px;
                y: 6.75px;
                width: 4.5px;
                height: 4.5px;
                border-radius: 2.25px;
                background: root.icon-color;
            }
        }
        if root.icon == "flag": Path {
            width: 16px;
            height: 16px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            viewbox-width: 16;
            viewbox-height: 16;
            commands: "M 2.5 1 L 4 1 L 4 15 L 2.5 15 Z M 4 2 L 13.5 4.25 L 4 6.5 Z";
            fill: root.icon-color;
        }
        if root.icon == "bookmark": Path {
            width: 16px;
            height: 16px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            viewbox-width: 16;
            viewbox-height: 16;
            commands: "M 3.5 1 L 12.5 1 L 12.5 15 L 8 11 L 3.5 15 Z";
            fill: root.icon-color;
        }
    }
    Text {
        x: 3px;
        y: 31px;
        width: parent.width - 6px;
        height: 12px;
        text: root.label;
        font-size: Theme.font-xs;
        color: root.enabled ? Theme.text : Theme.text-dim;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

// One label-over-value column of the bottom data-string bar. Rectangle root
// so the HorizontalLayout stretches it to the full bar height; the inner
// layout then centers the two lines in whatever height the bar has.
component DataSlot inherits Rectangle {
    in property <string> label;
    in property <string> value;

    min-width: 84px;
    horizontal-stretch: 1;

    VerticalLayout {
        alignment: center;

        Text {
            text: root.label;
            font-size: Theme.font-xs;
            color: Theme.text-dim;
            horizontal-alignment: center;
        }
        Text {
            text: root.value;
            font-size: Theme.font-sm;
            color: Theme.text;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
}

// Top status chip (LIVE / REC) with an elapsed timer.
component StatusChip inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <string> elapsed;
    in property <color> active-color;

    width: 128px;
    height: 22px;
    border-radius: 11px;
    background: root.active ? root.active-color : transparent;
    border-width: 1px;
    border-color: root.active ? root.active-color : Theme.border;

    HorizontalLayout {
        padding-left: Theme.spacing-sm;
        padding-right: Theme.spacing-sm;
        spacing: Theme.spacing-xs;
        alignment: center;

        // Explicit full-height wrappers: layout items keep their preferred
        // height in this centered layout, which top-pins the content —
        // vertical centering is done inside each wrapper instead.
        Rectangle {
            width: 7px;
            height: parent.height;

            Rectangle {
                y: (parent.height - 7px) / 2;
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                background: root.active ? white : Theme.text-dim;
            }
        }
        Text {
            height: parent.height;
            text: root.label;
            font-size: Theme.font-sm;
            color: root.active ? white : Theme.text-dim;
            vertical-alignment: center;
        }
        Text {
            height: parent.height;
            text: root.elapsed;
            font-size: Theme.font-sm;
            color: root.active ? white : Theme.text-dim;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

export component MainWindow inherits Window {
    title: "ROBS";
    preferred-width: 1280px;
    preferred-height: 720px;
    min-width: 800px;
    min-height: 600px;
    background: Theme.window;
    // App-wide typeface — bundled in the glue (assets/fonts/Nunito-*.ttf);
    // falls back to system fonts for glyphs Nunito lacks (e.g. the gear).
    default-font-family: "Nunito";

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    // ---- View-menu visibility: the PanelsApi show-* flags drive the shell.
    // The effective insets here MUST mirror the canvas fit math in
    // `src/push.rs` (rail/right/actions collapse to zero when hidden). ----
    property <bool> rail-shown: PanelsApi.show-scenes;
    property <bool> right-shown: PanelsApi.show-audio || PanelsApi.show-chat || PanelsApi.show-stats;
    property <bool> actions-shown: PanelsApi.show-controls;

    // ---- Phase 3: the annotation toolbar lives INSIDE the top bar (beside
    // the hamburger menu), so it no longer shifts the layout below. ----
    property <bool> annot-shown: PanelsApi.show-annotations;

    // ---- Top slim menu bar ----
    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: Theme.topbar-h;
        background: Theme.card;

        HorizontalLayout {
            // 2 x 128px chips + spacing + padding, 12px off the right edge.
            x: root.width - 292px;
            width: 280px;
            height: parent.height;
            spacing: Theme.spacing-sm;
            alignment: end;
            // Center the 22px chips in the 40px bar (fixed-height layout
            // items top-pin without this).
            cross-axis-alignment: center;

            StatusChip {
                label: "LIVE";
                active: Api.streaming;
                elapsed: Api.streaming-time;
                active-color: Theme.live-red;
            }
            StatusChip {
                label: "REC";
                active: Api.recording;
                elapsed: Api.recording-time;
                active-color: Theme.live-red;
            }
        }
    }

    // ---- QID rail (structure_components list from Postgres; clicking a QID
    // while recording marks segment boundaries) ----
    QidRail {
        x: 0;
        y: Theme.topbar-h;
        width: Theme.rail-w;
        height: root.height - Theme.topbar-h - Theme.data-h;
        visible: rail-shown;
    }

    // ---- Preview canvas area ----
    Rectangle {
        x: rail-shown ? Theme.rail-w : 0px;
        y: Theme.topbar-h;
        width: root.width - (rail-shown ? Theme.rail-w : 0px) - (right-shown ? Theme.right-w : 0px);
        height: root.height - Theme.topbar-h - (actions-shown ? Theme.actions-h : 0px) - Theme.data-h;
        visible: PanelsApi.show-preview;
        background: Theme.card;

        // ---- Scene selector bar (mockup): scene chips centered above the
        // stage; the gear at the far right opens the scene manager dialog
        // (add / rename / remove). Height mirrored by SCENEBAR_H in push.rs,
        // which letterboxes the canvas below this strip. ----
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: Theme.scenebar-h;

            HorizontalLayout {
                x: Theme.spacing-md;
                width: parent.width - 2 * Theme.spacing-md - 36px;
                height: parent.height;
                spacing: Theme.spacing-xs;
                alignment: start;

                for name in Api.scene-names: Rectangle {
                    width: max(min(chip-text.preferred-width + 36px, 220px), 120px);
                    height: 34px;
                    y: (parent.height - self.height) / 2;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: name == Api.selected-scene ? Theme.accent : Theme.border;
                    background: name == Api.selected-scene ? Theme.accent
                        : (chip-touch.has-hover ? Theme.card-alt : Theme.card);

                    chip-text := Text {
                        x: 14px;
                        width: parent.width - 28px;
                        height: parent.height;
                        text: name;
                        font-size: Theme.font-md;
                        font-weight: 700;
                        color: name == Api.selected-scene ? white : Theme.text;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    chip-touch := TouchArea {
                        mouse-cursor: self.has-hover ? MouseCursor.pointer : MouseCursor.default;
                        clicked => { Api.select-scene(name); }
                    }
                }
            }

            // QUAD VIEW button (right, beside the gear): four-square icon
            // drawn as rectangles (no symbol-font dependency).
            Rectangle {
                x: parent.width - 38px - 8px - 116px;
                y: (parent.height - 34px) / 2;
                width: 116px;
                height: 34px;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: quad-touch.has-hover ? Theme.accent : Theme.border;
                background: quad-touch.has-hover ? Theme.card-alt : Theme.card;

                quad-touch := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { }
                }
                HorizontalLayout {
                    x: 12px;
                    width: parent.width - 24px;
                    height: parent.height;
                    spacing: 8px;
                    alignment: center;

                    // 2x2 quad icon. Full-height wrapper + explicit inner
                    // centering — fixed-height items top-pin in centered
                    // HorizontalLayouts (see vault pitfall notes).
                    Rectangle {
                        width: 13px;
                        height: parent.height;

                        quad-grid := Rectangle {
                            width: 13px;
                            height: 13px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;

                            Rectangle { x: 0; y: 0; width: 6px; height: 6px; border-radius: 1px; background: Theme.accent; }
                            Rectangle { x: 7px; y: 0; width: 6px; height: 6px; border-radius: 1px; background: Theme.accent; }
                            Rectangle { x: 0; y: 7px; width: 6px; height: 6px; border-radius: 1px; background: Theme.accent; }
                            Rectangle { x: 7px; y: 7px; width: 6px; height: 6px; border-radius: 1px; background: Theme.accent; }
                        }
                    }
                    Text {
                        height: parent.height;
                        text: "QUAD VIEW";
                        font-size: Theme.font-xs;
                        font-weight: 700;
                        letter-spacing: 1px;
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                }
            }

            // Gear (far right): opens the scene manager dialog.
            // Same 34px height + y-centering as the scene chips and the
            // QUAD VIEW button so the whole row lines up.
            Rectangle {
                x: parent.width - 38px;
                y: (parent.height - 34px) / 2;
                width: 34px;
                height: 34px;
                border-radius: Theme.radius-sm;
                background: scene-gear-touch.has-hover ? Theme.border : transparent;
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: "\u{2699}";
                    font-size: 16px;
                    color: Theme.text;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                scene-gear-touch := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        SceneApi.edit-name = Api.selected-scene;
                        SceneApi.dialog-open = true;
                    }
                }
            }
        }

        // Letterboxed scene output (geometry pushed from the glue).
        Rectangle {
            x: Api.canvas-x - (rail-shown ? Theme.rail-w : 0px);
            y: Api.canvas-y - Theme.topbar-h;
            width: Api.canvas-width;
            height: Api.canvas-height;
            background: Theme.canvas-bg;
            border-width: 1px;
            border-color: Theme.border;

            for item[i] in Api.scene-items: Rectangle {
                x: item.x;
                y: item.y;
                width: item.width;
                height: item.height;
                visible: item.visible;
                border-width: 1px;
                border-color: Theme.border;

                // Named placeholder tile until the first frame arrives.
                if !item.has-frame: Rectangle {
                    width: 100%;
                    height: 100%;
                    background: Theme.placeholder;
                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: item.name;
                        font-size: Theme.font-sm;
                        color: Theme.text-dim;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                Image {
                    width: 100%;
                    height: 100%;
                    source: Api.item-frames[i];
                }
                // Source label above the item box (port of the egui label).
                Text {
                    x: 0;
                    y: -16px;
                    text: item.name;
                    font-size: Theme.font-sm;
                    color: #B4B4B4;
                }
            }

            // ---- Phase 3: annotation layer (visuals only — all pointer
            // handling runs through the single canvas TouchArea below). The
            // for-loops need a plain container because Slint cannot chain
            // `if` and `for` in one statement. ----
            if annot-shown: Rectangle {
                width: 100%;
                height: 100%;

                for ann in CanvasApi.annotations: Path {
                    width: 100%;
                    height: 100%;
                    viewbox-width: CanvasApi.scene-width;
                    viewbox-height: CanvasApi.scene-height;
                    commands: ann.commands;
                    stroke: ann.stroke;
                    stroke-width: ann.stroke-width * 1px;
                    fill: ann.filled ? ann.stroke : transparent;
                }

                // Text annotations render as plain strings at their point.
                for ann in CanvasApi.annotations: Text {
                    x: ann.x * 1px;
                    y: ann.y * 1px - ann.font-size * 1px;
                    text: ann.text;
                    font-size: ann.font-size * 1px;
                    color: ann.stroke;
                }
            }

            // The shape currently being dragged (live preview).
            if annot-shown && CanvasApi.drawing-active: Path {
                width: 100%;
                height: 100%;
                viewbox-width: CanvasApi.scene-width;
                viewbox-height: CanvasApi.scene-height;
                commands: CanvasApi.drawing.commands;
                stroke: CanvasApi.stroke-color;
                stroke-width: CanvasApi.stroke-width * 1px;
                fill: CanvasApi.filled ? CanvasApi.stroke-color : transparent;
            }

            // Selected annotation outline (cyan, like the egui port).
            if annot-shown && CanvasApi.has-selection: Rectangle {
                x: CanvasApi.sel-x * 1px - 4px;
                y: CanvasApi.sel-y * 1px - 4px;
                width: CanvasApi.sel-width * 1px + 8px;
                height: CanvasApi.sel-height * 1px + 8px;
                border-width: 1.5px;
                border-color: #00B4FF;
            }

            // Text overlays created from the Overlays tab — draggable labels.
            if annot-shown: Rectangle {
                width: 100%;
                height: 100%;

                for ov in CanvasApi.text-overlays: OverlayLabel {
                    overlay: ov;
                }
            }

            // Selected item corner handles (drag near a corner to resize —
            // the handles themselves are visuals only, like the egui ones).
            if annot-shown && CanvasApi.selected-item-index >= 0 && !CanvasApi.draw-active: Rectangle {
                x: Api.scene-items[CanvasApi.selected-item-index].x - 5px;
                y: Api.scene-items[CanvasApi.selected-item-index].y - 5px;
                width: Api.scene-items[CanvasApi.selected-item-index].width + 10px;
                height: Api.scene-items[CanvasApi.selected-item-index].height + 10px;
                border-width: 2px;
                border-color: #0078FF;

                ResizeHandle { x: 0; y: 0; }
                ResizeHandle { x: parent.width - self.width; y: 0; }
                ResizeHandle { x: 0; y: parent.height - self.height; }
                ResizeHandle { x: parent.width - self.width; y: parent.height - self.height; }
            }

            // Single canvas input surface: press/release/move funnel into the
            // glue, which runs the draw/select/resize state machine.
            if annot-shown: TouchArea {
                width: 100%;
                height: 100%;

                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down) {
                        CanvasApi.canvas-press(self.mouse-x / 1px, self.mouse-y / 1px);
                    }
                    if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                        CanvasApi.canvas-release(self.mouse-x / 1px, self.mouse-y / 1px);
                    }
                }
                changed mouse-x => {
                    if (self.pressed) { CanvasApi.canvas-move(self.mouse-x / 1px, self.mouse-y / 1px); }
                }
                changed mouse-y => {
                    if (self.pressed) { CanvasApi.canvas-move(self.mouse-x / 1px, self.mouse-y / 1px); }
                }
            }

            // Inline text-annotation editor (200px wide, like egui). Escape is
            // a DEVIATION: LineEdit has no escape callback, so empty commits
            // delete and non-empty commits save.
            if CanvasApi.editing: Rectangle {
                x: CanvasApi.edit-x * 1px;
                y: CanvasApi.edit-y * 1px;
                width: 210px;
                height: 30px;
                background: #101010E0;
                border-width: 1px;
                border-color: Theme.border;
                init => { ed.focus(); }

                HorizontalLayout {
                    padding-left: 3px;
                    padding-right: 3px;
                    padding-top: 3px;
                    padding-bottom: 3px;
                    spacing: 3px;

                    ed := LineEdit {
                        text <=> CanvasApi.text-input;
                        placeholder-text: "annotation text";
                        accepted(text) => { CanvasApi.commit-text-edit(text); }
                    }
                }
            }

            if Api.recording: Rectangle {
                x: 10px;
                y: 10px;
                width: 60px;
                height: 25px;
                border-radius: Theme.radius-sm;
                background: Theme.live-red;
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: "REC";
                    font-size: 14px;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            if !Api.scene-present: Text {
                width: parent.width;
                height: parent.height;
                text: "No Active Scene";
                font-size: 24px;
                color: Theme.text-dim;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // Snapshot confirmation toast (fades after ~1.5s).
            if Api.snapshot-flash: Rectangle {
                x: (parent.width - 190px) / 2;
                y: 15px;
                width: 190px;
                height: 30px;
                border-radius: Theme.radius-sm;
                background: #145A2D;
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: "Snapshot saved";
                    font-size: Theme.font-md;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    // ---- Quick Actions bar ----
    Rectangle {
        x: rail-shown ? Theme.rail-w : 0px;
        y: root.height - Theme.actions-h - Theme.data-h;
        width: root.width - (rail-shown ? Theme.rail-w : 0px) - (right-shown ? Theme.right-w : 0px);
        height: Theme.actions-h;
        visible: actions-shown;
        background: Theme.card-alt;

        HorizontalLayout {
            x: 0;
            width: parent.width;
            y: (parent.height - 50px) / 2;
            height: 50px;
            spacing: Theme.spacing-sm;
            // Centered under the stage like the mockup.
            alignment: center;

            QuickButton {
                icon: !Api.recording || Api.recording-paused ? "play" : "pause";
                label: !Api.recording ? "START" : (Api.recording-paused ? "RESUME" : "PAUSE");
                enabled: Api.can-start;
                clicked => { Api.start-pause-resume-record(); }
            }
            QuickButton {
                icon: "stop";
                label: "STOP";
                enabled: true;
                clicked => { Api.stop-all(); }
            }
            Rectangle { width: 1px; height: 28px; background: Theme.border; }
            QuickButton {
                icon: !Api.streaming ? "stream" : (Api.streaming-paused ? "play" : "pause");
                label: !Api.streaming ? "STREAM" : (Api.streaming-paused ? "RESUME" : "PAUSE");
                enabled: true;
                clicked => { Api.toggle-stream(); }
            }
            Rectangle { width: 1px; height: 28px; background: Theme.border; }
            QuickButton {
                icon: "camera";
                label: "SNAPSHOT";
                enabled: Api.can-snapshot;
                clicked => { Api.snapshot(); }
            }
            // BOOKMARK button hidden for now: the Api.bookmark callback only
            // writes an event-log line, so there is no real function yet.
            QuickButton {
                icon: "flag";
                label: "CLIP";
                enabled: Api.can-mark;
                clicked => { Api.toggle-clip-mark(); }
            }
        }
    }

    // ---- Right column: two stacked tab rows. Upper row holds the
    // scene-building panels (Sources / Overlays / Audio — the former Scenes
    // tab moved into the scene bar above the canvas); the lower row holds
    // observability (Stats / Log). Chat stays wired in the glue but is not
    // shown for now. ----
    Rectangle {
        x: root.width - Theme.right-w;
        y: Theme.topbar-h;
        width: Theme.right-w;
        height: root.height - Theme.topbar-h - Theme.data-h;
        visible: right-shown;
        background: Theme.card;

        // Two rows split 62/38 with a spacing-xs gutter. Explicit heights
        // (not a VerticalLayout): layout-driven TabWidgets negotiate
        // min-heights with the tab contents, which the compiler reports as
        // a binding loop through the tabs' inner layouts.
        TabWidget {
            x: Theme.spacing-xs;
            y: Theme.spacing-xs;
            width: parent.width - 2 * Theme.spacing-xs;
            height: (parent.height - 2 * Theme.spacing-xs) * 0.62 - Theme.spacing-xs / 2;

            Tab { title: "Sources"; SourcesTab {} }
            Tab { title: "Overlays"; OverlaysTab {} }
            Tab { title: "Audio"; AudioTab {} }
        }

        TabWidget {
            x: Theme.spacing-xs;
            y: Theme.spacing-xs + (parent.height - 2 * Theme.spacing-xs) * 0.62 + Theme.spacing-xs / 2;
            width: parent.width - 2 * Theme.spacing-xs;
            height: (parent.height - 2 * Theme.spacing-xs) * 0.38 - Theme.spacing-xs / 2;

            Tab { title: "Stats"; StatsTab {} }
            Tab { title: "Log"; EventLogTab {} }
        }
    }

    // ---- Data-string telemetry bar (always shown, full window width) ----
    Rectangle {
        x: 0;
        y: root.height - Theme.data-h;
        width: root.width;
        height: Theme.data-h;
        background: Theme.card-alt;

        // Top separator.
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: 1px;
            background: Theme.border;
        }

        HorizontalLayout {
            x: Theme.spacing-sm;
            width: parent.width - 2 * Theme.spacing-sm;
            height: parent.height;
            spacing: Theme.spacing-md;
            alignment: start;

            // Status: colored dot + "DATA STRING" over the live status
            // word. Dot and text block are centered in the bar explicitly
            // (no hardcoded y offsets — the bar height lives in Theme).
            Rectangle {
                width: 118px;
                height: parent.height;

                Rectangle {
                    x: 0;
                    y: (parent.height - 8px) / 2;
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: TelemetryApi.status-state == 1 ? Theme.success-green
                        : (TelemetryApi.status-state == 2 ? Theme.warning-orange : Theme.text-dim);
                }
                VerticalLayout {
                    x: 16px;
                    width: parent.width - 16px;
                    height: parent.height;
                    alignment: center;

                    Text {
                        text: "DATA STRING";
                        font-size: Theme.font-xs;
                        font-weight: 700;
                        color: Theme.text;
                    }
                    Text {
                        text: TelemetryApi.status;
                        font-size: Theme.font-xs;
                        color: TelemetryApi.status-state == 1 ? Theme.success-green
                            : (TelemetryApi.status-state == 2 ? Theme.warning-orange : Theme.text-dim);
                    }
                }
            }

            DataSlot { label: "EASTING"; value: TelemetryApi.easting; }
            DataSlot { label: "NORTHING"; value: TelemetryApi.northing; }
            DataSlot { label: "DEPTH"; value: TelemetryApi.depth; }
            DataSlot { label: "DATE"; value: TelemetryApi.date; }
            DataSlot { label: "TIME"; value: TelemetryApi.time; }
            DataSlot { label: "ROV HEADING"; value: TelemetryApi.heading; }
            DataSlot { label: "CP VALUE"; value: TelemetryApi.cp; }
            DataSlot { label: "FG VALUE"; value: TelemetryApi.fg; }
            DataSlot { label: "LAST CHECK"; value: TelemetryApi.last-check; }

            // Spacer pushes the gear to the right edge (zero stretch so the
            // equal-width DataSlots absorb all remaining space).
            Rectangle { horizontal-stretch: 0; }

            // Gear button: a full-height wrapper centers the 30x28 hover
            // chip (fixed-height layout items top-pin otherwise).
            Rectangle {
                width: 30px;
                height: parent.height;

                Rectangle {
                    y: (parent.height - 28px) / 2;
                    width: 30px;
                    height: 28px;
                    border-radius: Theme.radius-sm;
                    background: gear-touch.has-hover ? Theme.border : transparent;
                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: "\u{2699}";
                        font-size: 16px;
                        color: Theme.text;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    gear-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { TelemetryApi.open-dialog(); }
                    }
                }
            }
        }
    }

    // ---- Annotation toolbar (36px strip INSIDE the top bar, beside the
    // hamburger menu and vertically centered in the 40px row; it stops
    // before the LIVE/REC chips at -292px). Declared before the MenuBar
    // overlay so the hamburger and its dropdown stay on top. ----
    if annot-shown: AnnotationToolbar {
        x: 40px;
        y: (Theme.topbar-h - Theme.annotations-h) / 2;
        width: root.width - 40px - 292px;
    }

    // ---- Menu bar overlay (dropdowns extend over the regions below; the
    // click-away backdrop only exists while a menu is open) ----
    MenuBar {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;

        new-profile => { PanelsApi.new-profile(); }
        settings-opened => { PanelsApi.open-settings(); }
        exit-app => { PanelsApi.exit-app(); }
        undo => { PanelsApi.undo(); }
        redo => { PanelsApi.redo(); }
        about => { PanelsApi.about(); }
        select-profile(index) => { PanelsApi.select-profile(index); }
    }

    // ---- Settings window (self-hides unless PanelsApi.settings-open) ----
    SettingsWindow { }

    // ---- Data-string settings dialog (gear on the bottom bar) ----
    TelemetryDialog { }

    // ---- Scene manager dialog (gear on the scene bar above the canvas) ----
    SceneDialog { }

    // ---- Source-properties modal (topmost; hidden unless open) ----
    SourcePropertiesDialog { }
}
