//! Hamburger menu (top-left of the title bar): one button that opens a
//! single dropdown panel holding the former File / Edit / View / Profiles /
//! Help menus as labeled sections — the port of the egui menu bar
//! (`robs-ui/src/app/panels/menu.rs`). The component is placed as a
//! full-window transparent layer so its panel extends over the shell below;
//! the button only captures clicks inside its own bounds, and an open panel
//! installs a click-away backdrop that closes it. Escape closes too.
//!
//! Profiles are dynamic (`profile-names`, indexes passed back through
//! `select-profile`); the View entries toggle `PanelsApi.show-*` in place
//! (the panel stays open for toggles, like egui checkboxes).

import { Theme } from "theme.slint";
import { PanelsApi } from "panels_api.slint";
import { CanvasApi } from "canvas_api.slint";

component MenuHeader inherits Rectangle {
    in property <string> label;

    height: 22px;
    Text {
        x: Theme.spacing-sm;
        width: parent.width - 2 * Theme.spacing-sm;
        height: parent.height;
        text: root.label;
        font-size: Theme.font-xs;
        color: Theme.text-dim;
        letter-spacing: 1px;
        vertical-alignment: center;
    }
}

component MenuItemRow inherits Rectangle {
    in property <string> label;
    in property <bool> checked: false;
    callback triggered();

    height: 26px;
    background: touch.has-hover ? Theme.accent-dim : transparent;

    touch := TouchArea {
        mouse-cursor: self.has-hover ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            root.triggered();
        }
    }
    Text {
        x: Theme.spacing-sm;
        width: parent.width - 2 * Theme.spacing-sm;
        height: parent.height;
        text: (root.checked ? "\u{2713} " : "") + root.label;
        font-size: Theme.font-sm;
        color: touch.has-hover ? white : Theme.text;
        vertical-alignment: center;
        overflow: elide;
    }
}

component MenuSep inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

export component MenuBar inherits Rectangle {
    callback new-profile();
    callback settings-opened();
    callback exit-app();
    callback undo();
    callback redo();
    callback about();
    callback select-profile(int);

    property <bool> open: false;

    // Escape closes the panel. The scope grabs focus at startup; it has
    // no pointer handling, so clicks pass through to the layers below.
    foc := FocusScope {
        width: 100%;
        height: 100%;
        init => { self.focus(); }
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.open = false;
                accept
            } else if (e.text == Key.Delete || e.text == Key.Backspace) {
                // Phase 3: route Delete/Backspace to the annotation layer so
                // a selected annotation/overlay can be removed from the
                // keyboard; everything else falls through.
                if (CanvasApi.has-selection) {
                    CanvasApi.delete-selected();
                    accept
                } else {
                    reject
                }
            } else {
                reject
            }
        }
    }

    // Click-away backdrop: present only while the panel is open, so normal
    // pointer traffic passes straight through this layer otherwise.
    if root.open: TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.open = false; }
    }

    // ---- Hamburger button (top-left, inside the 40px title bar) ----
    Rectangle {
        x: 2px;
        y: (Theme.topbar-h - 36px) / 2;
        width: 36px;
        height: 36px;
        border-radius: Theme.radius-sm;
        background: root.open || burger-touch.has-hover ? Theme.card-alt : transparent;

        // Three bars drawn as rectangles (no glyph-font dependency).
        Rectangle { x: 10px; y: 12px; width: 16px; height: 2px; border-radius: 1px; background: Theme.text; }
        Rectangle { x: 10px; y: 17px; width: 16px; height: 2px; border-radius: 1px; background: Theme.text; }
        Rectangle { x: 10px; y: 22px; width: 16px; height: 2px; border-radius: 1px; background: Theme.text; }

        burger-touch := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.open = !root.open; }
        }
    }

    // ---- Dropdown panel: all five menus as labeled sections ----
    Rectangle {
        x: 2px;
        visible: root.open;
        y: Theme.topbar-h + 2px;
        width: 230px;
        height: col.preferred-height + 2 * Theme.spacing-xs;
        background: Theme.card;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.border;

        col := VerticalLayout {
            padding: Theme.spacing-xs;
            spacing: 0px;

            MenuHeader { label: "FILE"; }
            MenuItemRow {
                label: "New Profile";
                triggered => { root.open = false; root.new-profile(); }
            }
            MenuSep { }
            MenuItemRow {
                label: "Settings";
                triggered => { root.open = false; root.settings-opened(); }
            }
            MenuSep { }
            MenuItemRow {
                label: "Exit";
                triggered => { root.open = false; root.exit-app(); }
            }

            MenuHeader { label: "EDIT"; }
            MenuItemRow {
                label: "Undo";
                triggered => { root.open = false; root.undo(); }
            }
            MenuItemRow {
                label: "Redo";
                triggered => { root.open = false; root.redo(); }
            }

            MenuHeader { label: "VIEW"; }
            // Toggles keep the panel open, exactly like egui checkboxes.
            MenuItemRow {
                label: "Preview";
                checked: PanelsApi.show-preview;
                triggered => { PanelsApi.show-preview = !PanelsApi.show-preview; }
            }
            MenuItemRow {
                label: "QID Rail";
                checked: PanelsApi.show-scenes;
                triggered => { PanelsApi.show-scenes = !PanelsApi.show-scenes; }
            }
            MenuItemRow {
                label: "Controls";
                checked: PanelsApi.show-controls;
                triggered => { PanelsApi.show-controls = !PanelsApi.show-controls; }
            }
            MenuItemRow {
                label: "Audio Mixer";
                checked: PanelsApi.show-audio;
                triggered => { PanelsApi.show-audio = !PanelsApi.show-audio; }
            }
            MenuItemRow {
                label: "Chat";
                checked: PanelsApi.show-chat;
                triggered => { PanelsApi.show-chat = !PanelsApi.show-chat; }
            }
            MenuItemRow {
                label: "Stats";
                checked: PanelsApi.show-stats;
                triggered => { PanelsApi.show-stats = !PanelsApi.show-stats; }
            }
            MenuSep { }
            MenuItemRow {
                label: "Annotations Toolbar";
                checked: PanelsApi.show-annotations;
                triggered => { PanelsApi.show-annotations = !PanelsApi.show-annotations; }
            }

            MenuHeader { label: "PROFILES"; }
            for name[i] in PanelsApi.profile-names: MenuItemRow {
                label: name;
                triggered => {
                    root.open = false;
                    root.select-profile(i);
                }
            }

            MenuHeader { label: "HELP"; }
            MenuItemRow {
                label: "About ROBS";
                triggered => { root.open = false; root.about(); }
            }
        }
    }
}
