//! QID rail view contract (additive to the frozen `Api` global): the glue
//! pushes `structure_components` rows and the current-selection state, the
//! rail sends clicks, search text, and refresh requests back.

export struct QidRowView {
    /// `structure_components.id`.
    id: int,
    /// `structure_components.q_id`.
    q-id: string,
    /// Sub-label (`id_no`, fallback `code`).
    sub: string,
    /// True while this QID has an OPEN recording link (green highlight;
    /// several rows can be recording concurrently).
    recording: bool,
}

export struct QidOpenView {
    /// `structure_components.id` (clicking the entry ends this QID's link).
    id: int,
    /// `structure_components.q_id`.
    q-id: string,
    /// Sub-label (`id_no`, fallback `code`).
    sub: string,
    /// Wall-clock time the link opened ("14:32:42").
    start: string,
}

export global QidApi {
    // ---- Commands (UI -> glue) ----
    callback select-qid(int);
    callback refresh();
    // Live search filter; the glue re-pushes the filtered rows.
    callback search(string);
    // Info action: log every open link (or the armed QID) to the event log.
    callback details();

    // ---- View models (glue -> UI) ----
    in property <[QidRowView]> rows;
    // "QID LIST (N)" header count: total loaded rows, not the filtered view.
    in property <int> total;

    // ---- RECORDING panel (glue -> UI): every QID with an open link ----
    in property <bool> has-open;
    in property <int> open-count;
    // Open links ordered by start time.
    in property <[QidOpenView]> open-qids;

    // ---- DB status chip (glue -> UI) ----
    in property <string> db-status;
    // 0 = neutral, 1 = good (green), 2 = warn (orange).
    in property <int> db-status-state;

    // True while a recording runs — the only time QID rows are clickable.
    in property <bool> can-select;
}
