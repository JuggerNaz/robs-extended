//! Left rail (MockupUI): the QID LIST from the inspection database
//! (`structure_components.q_id`) plus the RECORDING panel. Replaces the
//! former scenes rail, which moved into the right-column tabs (Scenes /
//! Sources / Overlays). QID rows are clickable ONLY while a recording
//! runs: clicking a QID TOGGLES its recording link — idle QIDs open a new
//! segment, already-recording QIDs end only their own, so several QIDs can
//! record concurrently (see `robs-controller/qid.rs`).

import { Theme } from "theme.slint";
import { QidApi, QidOpenView, QidRowView } from "qid_api.slint";
import { ListView, LineEdit } from "std-widgets.slint";

// One entry of the QID list: status dot, QID over sub-label, click to mark.
// (The per-row property is `entry`: `row` clashes with a builtin name.)
component QidRow inherits Rectangle {
    in property <QidRowView> entry;
    callback clicked();

    height: 42px;
    border-radius: Theme.radius-sm;
    background: root.entry.recording ? #145A2D
        : ((touch.has-hover && QidApi.can-select) ? Theme.card-alt : transparent);

    // Rows only respond while a recording runs (QidApi.can-select): the
    // pointer cursor and hover highlight are suppressed when idle.
    touch := TouchArea {
        mouse-cursor: QidApi.can-select ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: Theme.spacing-sm;
        padding-right: Theme.spacing-sm;
        spacing: Theme.spacing-sm;

        // Status dot: green while the QID's recording link is open, dim
        // otherwise. Full-height wrapper + explicit inner centering —
        // fixed-height items top-pin in HorizontalLayouts (same idiom as
        // the QUAD VIEW icon).
        Rectangle {
            width: 10px;
            height: parent.height;

            Rectangle {
                width: 10px;
                height: 10px;
                y: (parent.height - self.height) / 2;
                border-radius: 5px;
                background: root.entry.recording ? Theme.success-green : Theme.border;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;

            Text {
                text: root.entry.q-id;
                font-size: Theme.font-sm;
                font-weight: 700;
                color: root.entry.recording ? white : Theme.text;
                overflow: elide;
            }
            Text {
                text: root.entry.sub;
                font-size: Theme.font-xs;
                color: root.entry.recording ? #C8E6C9 : Theme.text-dim;
                overflow: elide;
            }
        }
    }
}

// One open recording link in the RECORDING panel: green dot, QID over sub
// + start time; clicking the entry ends that QID's link (same toggle as
// clicking its row in the list).
component QidOpenRow inherits Rectangle {
    in property <QidOpenView> entry;
    callback clicked();

    height: 42px;
    border-radius: Theme.radius-sm;
    background: touch.has-hover ? #1B6B37 : transparent;

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: Theme.spacing-sm;
        padding-right: Theme.spacing-sm;
        spacing: Theme.spacing-sm;

        // Green dot: this link is open (same wrapper idiom as QidRow).
        Rectangle {
            width: 10px;
            height: parent.height;

            Rectangle {
                width: 10px;
                height: 10px;
                y: (parent.height - self.height) / 2;
                border-radius: 5px;
                background: Theme.success-green;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;

            Text {
                text: root.entry.q-id;
                font-size: Theme.font-sm;
                font-weight: 700;
                color: white;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: Theme.spacing-md;

                Text {
                    horizontal-stretch: 1;
                    text: root.entry.sub;
                    font-size: Theme.font-xs;
                    color: #C8E6C9;
                    overflow: elide;
                    vertical-alignment: center;
                }
                Text {
                    text: root.entry.start;
                    font-size: Theme.font-xs;
                    color: white;
                    vertical-alignment: center;
                }
            }
        }
    }
}

export component QidRail inherits Rectangle {
    background: Theme.card;

    // Two-way search text; `edited` re-pushes the filtered rows.
    property <string> search-text;

    VerticalLayout {
        padding: Theme.spacing-sm;
        spacing: Theme.spacing-xs;

        // ---- Header: QID LIST + total + refresh + DB status dot ----
        HorizontalLayout {
            height: 24px;
            spacing: Theme.spacing-xs;

            Text {
                text: "QID LIST";
                font-size: Theme.font-xs;
                color: Theme.text-dim;
                letter-spacing: 1px;
                vertical-alignment: center;
            }
            Text {
                text: "(" + QidApi.total + ")";
                font-size: Theme.font-xs;
                color: Theme.text-dim;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Rectangle {
                width: 8px;
                height: 8px;
                y: 8px;
                border-radius: 4px;
                background: QidApi.db-status-state == 1 ? Theme.success-green
                    : (QidApi.db-status-state == 2 ? Theme.warning-orange : Theme.text-dim);
            }
            Text {
                text: QidApi.db-status;
                font-size: Theme.font-xs;
                color: QidApi.db-status-state == 1 ? Theme.success-green
                    : (QidApi.db-status-state == 2 ? Theme.warning-orange : Theme.text-dim);
                vertical-alignment: center;
            }
            // Refresh: reload the component list from the database.
            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: Theme.radius-sm;
                background: refresh-touch.has-hover ? Theme.border : transparent;
                // Refresh arrow drawn as Paths (open circle + head): the UI
                // font lacks U+21BB (tofu box), and Slint Path has no arc
                // command, so the circle is a polyline (like the canvas
                // ellipses in canvas_glue).
                Path {
                    width: 14px;
                    height: 14px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    viewbox-width: 14;
                    viewbox-height: 14;
                    commands: "M 7.78 11.43 L 5.46 11.23 L 3.55 9.89 L 2.57 7.78 L 2.77 5.46 L 4.11 3.55 L 6.22 2.57 L 8.54 2.77 L 10.45 4.11 L 11.43 6.22 L 11.23 8.54";
                    stroke: Theme.text;
                    stroke-width: 1.25px;
                    fill: transparent;
                }
                Path {
                    width: 14px;
                    height: 14px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    viewbox-width: 14;
                    viewbox-height: 14;
                    commands: "M 10.2 11.36 L 9.35 7.86 L 13.11 9.22 Z";
                    fill: Theme.text;
                }
                refresh-touch := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { QidApi.refresh(); }
                }
            }
        }

        // ---- Search QID... ----
        LineEdit {
            height: 28px;
            placeholder-text: "Search QID...";
            text <=> root.search-text;
            edited(text) => { QidApi.search(text); }
        }

        // ---- QID rows ----
        Rectangle {
            vertical-stretch: 1;
            min-height: 72px;

            ListView {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;

                for entry in QidApi.rows: QidRow {
                    entry: entry;
                    clicked => { QidApi.select-qid(entry.id); }
                }
            }
        }

        // ---- RECORDING panel: every QID with an open link (green, like
        // the mockup). Grows one row per link, caps at four visible rows
        // (ListView scrolls beyond); clicking an entry ends that link. ----
        Rectangle {
            height: QidApi.has-open ? Math.min(32px + QidApi.open-count * 44px, 210px) : 74px;
            border-radius: Theme.radius-sm;
            background: QidApi.has-open ? #145A2D : Theme.card-alt;
            border-width: 1px;
            border-color: QidApi.has-open ? Theme.success-green : Theme.border;

            if !QidApi.has-open: Text {
                width: parent.width;
                height: parent.height;
                text: "No QID recording";
                font-size: Theme.font-sm;
                color: Theme.text-dim;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if QidApi.has-open: VerticalLayout {
                padding-left: Theme.spacing-sm;
                padding-right: Theme.spacing-sm;
                padding-top: Theme.spacing-xs;
                padding-bottom: Theme.spacing-xs;
                spacing: 2px;

                HorizontalLayout {
                    height: 22px;
                    spacing: Theme.spacing-xs;

                    // Info action: log every open link to the event log.
                    info-touch := TouchArea {
                        width: 14px;
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { QidApi.details(); }
                    }
                    // Info icon drawn as Paths (circle + i): the UI font
                    // lacks U+24D8 (tofu box).
                    Rectangle {
                        width: 14px;
                        height: parent.height;

                        Path {
                            width: 12px;
                            height: 12px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            viewbox-width: 14;
                            viewbox-height: 14;
                            commands: "M 12.5 7 L 11.76 9.75 L 9.75 11.76 L 7 12.5 L 4.25 11.76 L 2.24 9.75 L 1.5 7 L 2.24 4.25 L 4.25 2.24 L 7 1.5 L 9.75 2.24 L 11.76 4.25 Z";
                            stroke: #C8E6C9;
                            stroke-width: 1px;
                            fill: transparent;
                        }
                        Path {
                            width: 12px;
                            height: 12px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            viewbox-width: 14;
                            viewbox-height: 14;
                            commands: "M 6.3 6.2 L 7.7 6.2 L 7.7 10.2 L 6.3 10.2 Z M 7.95 4.1 L 7.67 4.78 L 7 5.05 L 6.33 4.78 L 6.05 4.1 L 6.33 3.43 L 7 3.15 L 7.67 3.43 Z";
                            fill: #C8E6C9;
                        }
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: "RECORDING  (" + QidApi.open-count + ")";
                        font-size: Theme.font-xs;
                        color: #C8E6C9;
                        letter-spacing: 1px;
                        vertical-alignment: center;
                    }
                }
                ListView {
                    vertical-stretch: 1;

                    for entry in QidApi.open-qids: QidOpenRow {
                        entry: entry;
                        clicked => { QidApi.select-qid(entry.id); }
                    }
                }
            }
        }
    }
}
