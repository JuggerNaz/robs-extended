//! Scene manager dialog (opened by the gear on the scene bar above the
//! canvas). Clean single-purpose layout: title + close (top, justified), a
//! scene list with per-row trash removal, inline rename on row click, and a
//! full-width ADD SCENE action. Icons are drawn as `Path` strokes — the shell
//! font renders most symbol codepoints as tofu.

import { Theme } from "theme.slint";
import { Api } from "api.slint";
import { SourcesApi } from "sources_api.slint";
import { SceneApi } from "scene_api.slint";
import { ListView, LineEdit } from "std-widgets.slint";

// Drawn X close glyph (two strokes) — U+2715 is tofu in the shell font.
component CloseIcon inherits Path {
    width: 10px;
    height: 10px;
    viewbox-width: 10;
    viewbox-height: 10;
    commands: "M 0 0 L 10 10 M 10 0 L 0 10";
    stroke: Theme.text-dim;
    stroke-width: 1.5px;
    fill: transparent;
}

// Drawn trash-can glyph (lid, handle, body) as stroked lines, with its
// click/hover area — TouchArea cannot nest inside Path, so the Path and the
// interaction area live as siblings inside this wrapper.
component TrashButton inherits Rectangle {
    width: 26px;

    trash-touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
    }
    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 12px;
        height: 12px;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: "M 1.5 3 L 10.5 3 M 4.5 3 L 4.5 1.5 L 7.5 1.5 L 7.5 3 M 3 3 L 3.5 10.5 L 8.5 10.5 L 9 3";
        stroke: trash-touch.has-hover ? Theme.live-red : Theme.text-dim;
        stroke-width: 1.2px;
        fill: transparent;
    }
}

export component SceneDialog inherits Rectangle {
    background: #00000080;
    visible: SceneApi.dialog-open;

    function commit-rename(name: string) {
        SceneApi.rename-scene(name, SceneApi.edit-name);
        SceneApi.selected-index = -1;
    }

    // Click-away backdrop closes the dialog.
    TouchArea {
        clicked => { SceneApi.dialog-open = false; }

        card := Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 360px;
            height: 320px;
            border-radius: Theme.radius;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.border;

            // Keep clicks on the card from falling through to the backdrop.
            TouchArea { }

            VerticalLayout {
                padding: Theme.spacing-md;
                spacing: Theme.spacing-sm;

                // ---- Title row: SCENES ... close (justified) ----
                HorizontalLayout {
                    height: 24px;
                    spacing: Theme.spacing-sm;

                    Text {
                        text: "SCENES";
                        font-size: Theme.font-md;
                        font-weight: 700;
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                    Rectangle { }
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: Theme.radius-sm;
                        background: close-touch.has-hover ? Theme.border : transparent;

                        CloseIcon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                        close-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { SceneApi.dialog-open = false; }
                        }
                    }
                }

                // ---- Scene list: click to inline-rename, trash to remove ----
                Rectangle {
                    vertical-stretch: 1;

                    ListView {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;

                        for name[i] in Api.scene-names: Rectangle {
                            height: 36px;
                            border-radius: Theme.radius-sm;
                            background: row-touch.has-hover ? Theme.card-alt : Theme.card;

                            row-touch := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => {
                                    SceneApi.selected-index = i;
                                    SceneApi.edit-name = name;
                                }
                            }

                            HorizontalLayout {
                                x: Theme.spacing-sm;
                                width: parent.width - 2 * Theme.spacing-sm;
                                height: parent.height;
                                spacing: Theme.spacing-xs;

                                // Name (or the inline rename editor for the
                                // row being edited).
                                if SceneApi.selected-index == i: LineEdit {
                                    width: parent.width - 34px;
                                    y: (parent.height - self.preferred-height) / 2;
                                    text <=> SceneApi.edit-name;
                                    placeholder-text: "scene name";
                                    accepted(text) => { root.commit-rename(name); }
                                }
                                if SceneApi.selected-index != i: Text {
                                    width: parent.width - 34px;
                                    height: parent.height;
                                    text: name;
                                    font-size: Theme.font-sm;
                                    color: name == Api.selected-scene ? Theme.accent-hover : Theme.text;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                // Trash: remove this scene (glue no-ops on
                                // the last remaining scene).
                                TrashButton {
                                    TouchArea {
                                        clicked => {
                                            SceneApi.selected-index = -1;
                                            SceneApi.remove-scene(name);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ---- Add: full-width action ----
                Rectangle {
                    height: 34px;
                    border-radius: Theme.radius-sm;
                    background: add-touch.has-hover ? Theme.accent-hover : Theme.accent;

                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: "+ ADD SCENE";
                        font-size: Theme.font-sm;
                        font-weight: 700;
                        color: white;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    add-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { SourcesApi.add-scene(); }
                    }
                }
            }
        }
    }
}
