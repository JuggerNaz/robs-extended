//! Right-column "Sources" tab: the roomy counterpart of the rail's compact
//! manager — add-source groups as accordions (Display / Window / Camera) and
//! the current scene's source rows. Drives the exact same `SourcesApi`
//! commands as the rail; both stay in sync through the glue.

import { Theme } from "theme.slint";
import { Api } from "api.slint";
import { SourcesApi } from "sources_api.slint";
import { ListView } from "std-widgets.slint";
import { PickerRow, SourceRow } from "scenes_rail.slint";

component SectionLabel inherits Text {
    height: 24px;
    vertical-alignment: center;
    font-size: Theme.font-xs;
    color: Theme.text-dim;
    letter-spacing: 1px;
}

// One collapsible add-source group: header (disclosure + label + count) and,
// when open, its entry rows (or an empty-state hint).
component SourceGroup inherits Rectangle {
    in property <string> label;
    in property <[string]> entries;
    callback add-index(int);
    callback add-name(string);

    property <bool> open: false;

    height: !root.open ? 28px
        : (root.entries.length == 0 ? 50px
        : Math.min(root.entries.length * 22px, 110px) + 34px);

    border-radius: Theme.radius-sm;
    background: Theme.card-alt;

    header-touch := TouchArea {
        width: 100%;
        height: 30px;
        mouse-cursor: self.has-hover ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.open = !root.open; }
    }
    VerticalLayout {
        HorizontalLayout {
            height: 30px;
            padding-left: Theme.spacing-sm;
            padding-right: Theme.spacing-sm;
            spacing: Theme.spacing-sm;

            Text {
                width: 12px;
                height: parent.height;
                text: root.open ? "\u{25BE}" : "\u{25B8}";
                font-size: Theme.font-md;
                color: Theme.text-dim;
                vertical-alignment: center;
            }
            Text {
                horizontal-stretch: 1;
                height: parent.height;
                text: root.label;
                font-size: Theme.font-sm;
                color: Theme.text;
                vertical-alignment: center;
            }
            Text {
                width: 24px;
                height: parent.height;
                text: root.entries.length;
                font-size: Theme.font-xs;
                color: Theme.text-dim;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }
        if root.open && root.entries.length == 0: Text {
            height: 20px;
            text: "Nothing detected";
            font-size: Theme.font-sm;
            color: Theme.text-dim;
            vertical-alignment: center;
            x: Theme.spacing-md;
        }
        if root.open && root.entries.length > 0: ListView {
            height: parent.height - 34px;
            x: Theme.spacing-xs;
            width: parent.width - 2 * Theme.spacing-xs;

            for entry[i] in root.entries: PickerRow {
                label: entry;
                clicked => {
                    root.add-index(i);
                    root.add-name(entry);
                }
            }
        }
    }
}

export component SourcesTab inherits Rectangle {
    background: transparent;

    VerticalLayout {
        padding: Theme.spacing-sm;
        spacing: Theme.spacing-sm;

        if !Api.scene-present: Text {
            height: parent.height;
            text: "No active scene";
            font-size: Theme.font-md;
            color: Theme.text-dim;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        if Api.scene-present: SectionLabel { text: "ADD SOURCE"; }

        // Add-source groups: display by monitor, window by title (index into
        // the pushed list), camera by device name.
        if Api.scene-present: SourceGroup {
            label: "Display Capture";
            entries: SourcesApi.monitor-names;
            add-index(i) => { SourcesApi.add-display-source(i); }
            add-name(label) => { }
        }
        if Api.scene-present: SourceGroup {
            label: "Window Capture";
            entries: SourcesApi.window-names;
            add-index(i) => { SourcesApi.add-window-source(i); }
            add-name(label) => { }
        }
        if Api.scene-present: SourceGroup {
            label: "Video Capture Device";
            entries: SourcesApi.camera-names;
            add-index(i) => { }
            add-name(cam) => { SourcesApi.add-webcam-source(cam); }
        }

        Rectangle { height: 1px; background: Theme.border; }

        if Api.scene-present: SectionLabel { text: "IN SCENE"; }

        if Api.scene-present: Rectangle {
            vertical-stretch: 1;

            ListView {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;

                for r in SourcesApi.source-rows: SourceRow {
                    source: r;
                    toggle-visible(v) => { SourcesApi.set-source-visible(r.id, v); }
                    properties => { SourcesApi.source-properties(r.id); }
                    move-up => { SourcesApi.move-source-up(r.id); }
                    move-down => { SourcesApi.move-source-down(r.id); }
                    remove => { SourcesApi.remove-source(r.id); }
                }
            }
        }
    }
}
